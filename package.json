{
  "name": "@uaiui/ds",
  "version": "0.5.0",
  "description": "UaiUI design system: DTCG design tokens and accessible, framework-agnostic CSS components.",
  "license": "MIT",
  "author": "Lucas Pereira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucas-per/uaiui-ds.git"
  },
  "homepage": "https://lpereira.me/projetos/uaiui/",
  "bugs": {
    "url": "https://github.com/lucas-per/uaiui-ds/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "css",
    "accessibility",
    "wcag"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tokens": "node scripts/dtcg-to-css.mjs",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && astro build",
    "preview": "astro preview",
    "check": "node scripts/dtcg-to-css.mjs --check && node scripts/check-wrapper.mjs && node scripts/check-hover-media.mjs && astro check",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "src/styles/tokens.css",
    "src/styles/tokens-wrapper.css",
    "src/styles/components",
    "tokens",
    "LICENSE"
  ],
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./tokens-wrapper.css": "./src/styles/tokens-wrapper.css",
    "./components/button.css": "./src/styles/components/button.css",
    "./components/accordion.css": "./src/styles/components/accordion.css",
    "./components/toast.css": "./src/styles/components/toast.css",
    "./tokens/uaiui.resolver.json": "./tokens/uaiui.resolver.json",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "astro": "^7.3.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
