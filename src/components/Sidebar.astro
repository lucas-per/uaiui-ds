---
import { nav } from '../data/nav';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<aside class="sidebar" id="sidebar" aria-label="Documentação" data-sidebar>
  {nav.map((g) => (
    <section>
      <h2>{g.title}</h2>
      <ul>
        {g.items.map((i) => (
          <li><a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.title}{i.status && <span class="badge-novo">{i.status}</span>}</a></li>
        ))}
      </ul>
    </section>
  ))}
</aside>
