---
import { withBase, stripBase } from '../data/url';
const path = stripBase(Astro.url.pathname);
const links = [{ href: '/docs', label: 'Docs' }, { href: '/docs/components/button', label: 'Componentes' }, { href: '/docs/tokens', label: 'Tokens' }];
const isActive = (h: string) => (h === '/docs/components/button' ? path.startsWith('/docs/components') : h === '/docs' ? path === '/docs' : path.startsWith(h));
---
<header class="site-header">
  <div class="site-header__in">
    <button type="button" class="menu-btn uai-button uai-icon-button" data-type="outlined" data-menu aria-label="Abrir menu" aria-expanded="false" aria-controls="sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href={withBase("/")}><span class="brand__mark" aria-hidden="true">U</span>UaiUI</a>
    <nav class="site-nav" aria-label="Principal">
      {links.map((l) => <a href={withBase(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="header-tools">
      <button type="button" class="search-btn" data-search-open aria-haspopup="dialog">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="M15 15l6 6"/></svg>
        <span>Buscar na documentação</span><kbd>Ctrl K</kbd>
      </button>
      <label class="tool-select"><span>Tema</span>
        <select data-theme-select aria-label="Tema"><option value="system">Sistema</option><option value="light">Claro</option><option value="dark">Escuro</option></select>
      </label>
      <label class="tool-select"><span>Densidade</span>
        <select data-density-select aria-label="Densidade"><option value="comfortable">Comfortable</option><option value="standard">Standard</option><option value="compact">Compact</option></select>
      </label>
    </div>
  </div>
</header>
